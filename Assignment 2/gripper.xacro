<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Two-finger parallel gripper.
       gripper_span = maximum gap between the finger inner faces.
       Each finger travels gripper_span/2, so the gap = 2*q, from 0 to gripper_span. -->
  <xacro:macro name="gripper_component" params="gripper_span">

    <!-- Palm: wide enough to cover the fully open fingers. Extends from x=0 to x=0.05. -->
    <link name="gripper_base_link">
      <visual>
        <origin xyz="0.025 0 0" rpy="0 0 0"/>
        <geometry><box size="0.05 ${gripper_span + 0.04} 0.05"/></geometry>
        <material name="gripper_dark"><color rgba="0.25 0.25 0.25 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.025 0 0" rpy="0 0 0"/>
        <geometry><box size="0.05 ${gripper_span + 0.04} 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.025 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Left finger (+y side) -->
    <link name="left_finger_link">
      <visual>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <geometry><box size="0.10 0.02 0.05"/></geometry>
        <material name="finger_blue"><color rgba="0.1 0.3 0.9 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <geometry><box size="0.10 0.02 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Right finger (-y side) -->
    <link name="right_finger_link">
      <visual>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <geometry><box size="0.10 0.02 0.05"/></geometry>
        <material name="finger_blue"><color rgba="0.1 0.3 0.9 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <geometry><box size="0.10 0.02 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- At q = 0 the finger centres are at y = +/-0.01, so the inner faces touch at y = 0.
         Positive q moves each finger outward, so the gap between inner faces is 2*q. -->
    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="left_finger_link"/>
      <origin xyz="0.05 0.01 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="${gripper_span/2}" effort="20" velocity="0.05"/>
    </joint>

    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="right_finger_link"/>
      <origin xyz="0.05 -0.01 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="${gripper_span/2}" effort="20" velocity="0.05"/>
    </joint>

    <!-- Tool centre point: halfway along the fingers, same height as the carriage
         (z offset 0), so TCP height = base_height + q_vertical. -->
    <link name="tool_frame"/>
    <joint name="gripper_to_tool_joint" type="fixed">
      <parent link="gripper_base_link"/>
      <child link="tool_frame"/>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>