<?xml version="1.0"?>
<robot name="domestic_assistant_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="base.xacro"/>
  <xacro:include filename="arm.xacro"/>
  <xacro:include filename="gripper.xacro"/>

  <!-- ===== Parameters ===== -->
  <xacro:property name="base_radius"   value="0.15"/>
  <xacro:property name="base_height"   value="0.20"/>
  <xacro:property name="link1_length"  value="0.80"/>
  <xacro:property name="link2_length"  value="0.60"/>
  <xacro:property name="gripper_span"  value="0.12"/>

  <!-- ===== World ===== -->
  <link name="world"/>

  <!-- ===== Components ===== -->
  <xacro:base_component base_radius="${base_radius}" base_height="${base_height}"/>

  <xacro:arm_component base_height="${base_height}"
                       link1_length="${link1_length}"
                       link2_length="${link2_length}"/>

  <xacro:gripper_component gripper_span="${gripper_span}"/>

  <!-- ===== Connections (all assembly joints live here) ===== -->
  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gripper mounts at the tip of the sliding arm (arm box is 0.10 m long). -->
  <joint name="arm_to_gripper_joint" type="fixed">
    <parent link="horizontal_arm_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
  </joint>

</robot>