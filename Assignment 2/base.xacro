<?xml version="1.0"?>

<robot name="domestic_assistant_base"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="base_component"
                 params="base_radius base_height">

        <link name="base_link">

            <visual>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${base_radius}"
                              length="${base_height}"/>
                </geometry>
                <material name="grey">
                    <color rgba="0.5 0.5 0.5 1"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${base_radius}"
                              length="${base_height}"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <mass value="2.0"/>
                <inertia
                    ixx="${2.0*(3*base_radius*base_radius + base_height*base_height)/12}"
                    ixy="0" ixz="0"
                    iyy="${2.0*(3*base_radius*base_radius + base_height*base_height)/12}"
                    iyz="0"
                    izz="${2.0*base_radius*base_radius/2}"/>
            </inertial>

        </link>

    </xacro:macro>

</robot>
